# Copy to .env and fill in. Never commit .env — it holds a database password.
# Supabase dashboard → project → Settings → Database → Connection string → URI, pooler mode (port 6543).
DATABASE_URL=postgresql://postgres:<password>@<host>.pooler.supabase.com:6543/postgres
# OPENROUTER_API_KEY=...  # only needed when starting a run with aiSecondPass: true
# PORT=8788
