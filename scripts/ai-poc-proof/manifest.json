   "deployments": [
    {
     "name": "vault",
     "contract": "ReentrancyVault"
    }
   ],
   "target": "vault",
   "setup": [
    {
     "from": 1,
     "to": "{{addr:vault}}",
     "sig": "deposit()",
     "value": "9ether"
    }
   ]
  },
