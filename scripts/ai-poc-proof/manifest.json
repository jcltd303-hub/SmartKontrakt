   "id": "03-reentrancy-erc777",
   "file": "03-reentrancy-erc777.t.sol",
   "detector": "reentrancy",
   "scenario": "ERC777 tokensReceived hook reentrancy",
   "fixture": "03-reentrancy-erc777.sol",
   "contractName": "ERC777Vault",
   "flaw": "withdraw() sends ERC777 tokens (firing the recipient's tokensReceived hook) before debiting the caller's deposit ledger, so the hook re-enters withdraw() and withdraws the same deposit repeatedly.",
   "deployments": [
    {
     "name": "token",
     "contract": "Mock777"
    },
    {
     "name": "vault",
     "contract": "ERC777Vault",
     "args": [
      "$token"
     ]
    }
   ],
   "target": "vault",
   "setup": [
    {
     "from": 0,
     "to": "{{addr:token}}",
     "sig": "mint(address,uint256)",
     "args": [
      "{{addr:vault}}",
      "100000"
     ]
    }
   ],
   "adapt": [
    {
     "find": "address public constant TOKEN = address(0);",
     "replace": "address public constant TOKEN = {{addr:token}};"
    },
    {
     "find": "IERC777(TOKEN).send(address(attacker), 1000, bytes(\"\"));",
     "replace": "(bool mintOk_,) = TOKEN.call(abi.encodeWithSignature(\"mint(address,uint256)\", address(attacker), uint256(1000))); require(mintOk_, \"mint failed\");"
    }
   ]
  },
